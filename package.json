{
  "name": "dustin.younse.com",
  "version": "0.0.1",
  "description": "A personal website",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production npm-run-all clean build:vite build:11ty",
    "build:11ty": "eleventy --quiet",
    "build:vite": "vite build",
    "clean": "rm -rf dist",
    "dev": "NODE_ENV=development npm-run-all -p dev:vite dev:11ty",
    "dev:11ty": "eleventy --quiet --serve",
    "dev:vite": "vite",
    "serve": "serve dist",
    "check-links": "check-html-links dist",
    "lint": "eslint src",
    "lint:all": "npm-run-all -p check-links lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milsyobtaf/dustin.younse.com.git"
  },
  "dependencies": {
    "alpinejs": "^3.15.8"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@alpinejs/collapse": "^3.15.8",
    "@cspell/eslint-plugin": "^9.7.0",
    "@eslint/json": "^0.13.2",
    "@eslint/markdown": "^7.5.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.1",
    "check-html-links": "^0.2.4",
    "eslint": "^9.39.3",
    "globals": "^16.5.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "prettier-plugin-jinja-template": "^2.1.0",
    "serve": "^14.2.5",
    "tailwindcss": "^4.2.1",
    "tailwindcss-debug-screens": "^3.0.1",
    "twig": "^1.17.1",
    "vite": "^6.4.1"
  }
}
