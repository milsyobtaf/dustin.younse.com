{
  "name": "dustin.younse.com",
  "version": "0.0.1",
  "description": "A personal website",
  "type": "module",
  "engines": {
    "node": ">=20.x.x"
  },
  "scripts": {
    "build": "npm-run-all clean build:11ty",
    "build:11ty": "cross-env ELEVENTY_ENV=production eleventy",
    "serve": "serve dist",
    "dev": "npm run dev:11ty",
    "dev:11ty": "cross-env ELEVENTY_ENV=development eleventy --serve --quiet",
    "clean": "rimraf dist src/_includes/css src/_includes/scripts",
    "clean:og": "rimraf src/assets/og-images",
    "favicons": "node ./src/_config/setup/generate-favicons.js",
    "colors": "node ./src/_config/setup/create-colors.js",
    "screenshots": "node ./src/_config/setup/generate-screenshots.js",
    "lint": "eslint src",
    "lint:all": "npm-run-all -p check-links lint",
    "check-links": "check-html-links dist",
    "pa11y:build": "npm run clean && cross-env ELEVENTY_ENV=test eleventy",
    "pa11y:test": "sleep 3 && pa11y-ci --config ./dist/pa11y.json",
    "pa11y:serve": "ELEVENTY_ENV=test eleventy --serve --ignore-initial",
    "test:a11y": "npm run pa11y:build && (npm run pa11y:serve &) && sleep 5 && npm run pa11y:test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milsyobtaf/dustin.younse.com.git"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-fetch": "^5.1.1",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-plugin-directory-output": "^1.0.2",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@11ty/eleventy-plugin-webc": "^0.11.2",
    "@11ty/is-land": "^4.0.1",
    "lite-youtube-embed": "^0.3.4",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@alpinejs/collapse": "^3.15.8",
    "@cspell/eslint-plugin": "^9.7.0",
    "@toycode/markdown-it-class": "^1.2.4",
    "alpinejs": "^3.15.8",
    "autoprefixer": "^10.4.27",
    "check-html-links": "^0.2.4",
    "colorjs.io": "^0.6.1",
    "cross-env": "^10.1.0",
    "cssnano": "^7.1.2",
    "dayjs": "^1.11.19",
    "dotenv": "^17.3.1",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.4",
    "fast-glob": "^3.3.3",
    "globals": "^16.5.0",
    "html-minifier-terser": "^7.2.0",
    "js-yaml": "^4.1.1",
    "luxon": "^3.7.2",
    "markdown-it": "^14.1.1",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-link-attributes": "^4.0.1",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-prism": "^3.0.1",
    "netlify-plugin-cache": "^1.0.3",
    "npm-run-all": "^4.1.5",
    "pa11y-ci": "^4.0.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-import-ext-glob": "^2.1.1",
    "postcss-js": "^5.1.0",
    "prettier": "^3.8.1",
    "prettier-plugin-jinja-template": "^2.1.0",
    "rimraf": "^6.1.3",
    "sanitize-html": "^2.17.1",
    "sharp": "^0.34.5",
    "sharp-ico": "^0.1.5",
    "slugify": "^1.6.6",
    "svgo": "^4.0.0",
    "tailwindcss-debug-screens": "^2.2.1",
    "vite": "^6.4.1"
  }
}
