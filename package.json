{
  "name": "dustin.younse.com",
  "version": "0.0.1",
  "description": "A personal website",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production npm-run-all clean build:vite build:11ty",
    "build:11ty": "eleventy --quiet",
    "build:vite": "vite build",
    "clean": "rm -rf dist",
    "dev": "NODE_ENV=development npm-run-all -p dev:vite dev:11ty",
    "dev:11ty": "eleventy --quiet --serve",
    "dev:vite": "vite",
    "serve": "serve dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milsyobtaf/dustin.younse.com.git"
  },
  "dependencies": {
    "alpinejs": "^3.1.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.0.6",
    "npm-run-all": "^4.1.5",
    "serve": "^14.2.4",
    "tailwindcss": "^4.0.0",
    "twig": "^1.15.4",
    "vite": "^6.3.4"
  }
}
