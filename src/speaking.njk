---
title: Speaking
talk_years:
  - 2022
  - 2021
  - 2020
  - 2018
  - 2017
  - 2016
  - 2015
  - 2014
  - 2013
  - 2012
---

{% extends 'layout.njk' %}
{% block body %}
  <main class="container py-16 prose">
    <h1>{{ title }}</h1>
    {% for year in talk_years %}
      <ul class="speaking-engagement list-none not-prose p-0 pb-4">
        <h3>{{ year }}</h3>
        {% for talk in speaking %}
          {% if talk.year == year %}
            <ul class="list-none not-prose p-0 pb-4">
              <li class="p-0 m-0 leading-5 font-bold text-gray-900">
                <a class="underline" href="{{ talk.url }}">{{ talk.title }}</a>
              </li>
              <li class="p-0 m-0 leading-5 italic">
                {{ talk.event }} {{ talk.year }}
              </li>
              {% if talk.type == "academic" %}
                <li class="p-0 m-0 leading-5">Academic Talk</li>
              {% endif %}
            </ul>
          {% endif %}
        {% endfor %}
      </ul>
    {% endfor %}
  </main>
{% endblock %}
