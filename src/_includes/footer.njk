<section class="text-center py-6 bg-gray-100">
  <h2 class="text-3xl font-bold">Get in touch</h2>
  <p
    class="text-muted-foreground-light mb-8 mx-auto max-w-lg"
  >
    {{ contact.subTitle }}
  </p>
  <div class="flex justify-center gap-8">
    {% for link in links %}
    <a
      aria-label="{{ link.name }}"
      href="{{ link.url }}"
      rel="me"
      target="_blank"
      class="inline-flex w-12 h-8 justify-center links-center ml-2 rounded-full highlight text-muted-foreground-light hover:opacity-80 transition-opacity"
    >
      {% if link.icon %} {{ link.icon | safe }} {% endif %}
    </a>
    {% endfor %}
  </div>
</section>
<footer class="text-center text-sm text-muted-foreground-light bg-gray-100 mx-4">
  <p>&copy; {% year %} Dustin Younse. All rights reserved.</p>
  <p>{{ dictionary.footer.builtWith | safe }}</p>
</footer>
